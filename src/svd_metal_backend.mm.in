id<MTLDevice> default_device() {
  static id<MTLDevice> device = MTLCreateSystemDefaultDevice();
  return device;
}

id<MTLCommandQueue> default_command_queue() {
  static id<MTLCommandQueue> queue = nil;
  static dispatch_once_t once;
  dispatch_once(&once, ^{
    id<MTLDevice> device = default_device();
    if (device != nil) {
      queue = [device newCommandQueue];
    }
  });
  return queue;
}

template<typename T>
void copy_to_mps_buffer(const arma::Mat<T>& X, id<MTLBuffer> buffer,
                        const NSUInteger row_bytes) {
  const arma::uword nr = X.n_rows;
  const arma::uword nc = X.n_cols;
  char* base = static_cast<char*>([buffer contents]);
  // Tile the column-major/row-major copy so neither side repeatedly evicts
  // cache lines from the other. Casts and matrix entries are unchanged.
  constexpr arma::uword tile = 32;
  for (arma::uword row0 = 0; row0 < nr; row0 += tile) {
    const arma::uword row_end = std::min(nr, row0 + tile);
    for (arma::uword col0 = 0; col0 < nc; col0 += tile) {
      const arma::uword col_end = std::min(nc, col0 + tile);
      for (arma::uword j = col0; j < col_end; ++j) {
        const T* column = X.colptr(j);
        for (arma::uword i = row0; i < row_end; ++i) {
          float* row = reinterpret_cast<float*>(base + static_cast<NSUInteger>(i) * row_bytes);
          row[j] = static_cast<float>(column[i]);
        }
      }
    }
  }
}

void copy_arma_to_mps_buffer(const arma::mat& X,
                             id<MTLBuffer> buffer,
                             const NSUInteger row_bytes) {
  copy_to_mps_buffer(X, buffer, row_bytes);
}

void copy_fmat_to_mps_buffer(const arma::fmat& X,
                             id<MTLBuffer> buffer,
                             const NSUInteger row_bytes) {
  copy_to_mps_buffer(X, buffer, row_bytes);
}

template<typename T>
arma::Mat<T> copy_from_mps_buffer(id<MTLBuffer> buffer, const arma::uword nr,
                                  const arma::uword nc, const NSUInteger row_bytes) {
  arma::Mat<T> out(nr, nc);
  const char* base = static_cast<const char*>([buffer contents]);
  constexpr arma::uword tile = 32;
  for (arma::uword row0 = 0; row0 < nr; row0 += tile) {
    const arma::uword row_end = std::min(nr, row0 + tile);
    for (arma::uword col0 = 0; col0 < nc; col0 += tile) {
      const arma::uword col_end = std::min(nc, col0 + tile);
      for (arma::uword j = col0; j < col_end; ++j) {
        T* column = out.colptr(j);
        for (arma::uword i = row0; i < row_end; ++i) {
          const float* row = reinterpret_cast<const float*>(base + static_cast<NSUInteger>(i) * row_bytes);
          column[i] = static_cast<T>(row[j]);
        }
      }
    }
  }
  return out;
}

arma::mat copy_mps_buffer_to_arma(id<MTLBuffer> buffer,
                                  const arma::uword nr,
                                  const arma::uword nc,
                                  const NSUInteger row_bytes) {
  return copy_from_mps_buffer<double>(buffer, nr, nc, row_bytes);
}

arma::fmat copy_mps_buffer_to_fmat(id<MTLBuffer> buffer,
                                   const arma::uword nr,
                                   const arma::uword nc,
                                   const NSUInteger row_bytes) {
  return copy_from_mps_buffer<float>(buffer, nr, nc, row_bytes);
}

struct MetalMatrix {
  id<MTLBuffer> buffer;
  NSUInteger rows;
  NSUInteger cols;
  NSUInteger row_bytes;
};

MetalMatrix make_matrix(id<MTLDevice> device,
                        const NSUInteger rows,
                        const NSUInteger cols) {
  MetalMatrix M;
  M.rows = rows;
  M.cols = cols;
  M.row_bytes = [MPSMatrixDescriptor rowBytesFromColumns:cols dataType:MPSDataTypeFloat32];
  M.buffer = [device newBufferWithLength:(M.row_bytes * rows) options:MTLResourceStorageModeShared];
  if (M.buffer == nil) {
    throw std::runtime_error("metal_simpls_resident: failed to allocate Metal buffer");
  }
  std::fill_n(static_cast<char*>([M.buffer contents]), static_cast<std::size_t>(M.row_bytes * rows), 0);
  return M;
}

MetalMatrix make_matrix_from_arma(id<MTLDevice> device, const arma::mat& X) {
  MetalMatrix M = make_matrix(device, static_cast<NSUInteger>(X.n_rows), static_cast<NSUInteger>(X.n_cols));
  copy_arma_to_mps_buffer(X, M.buffer, M.row_bytes);
  return M;
}

MPSMatrix* mps_matrix(const MetalMatrix& M) {
  MPSMatrixDescriptor* desc = [MPSMatrixDescriptor
    matrixDescriptorWithRows:M.rows
    columns:M.cols
    rowBytes:M.row_bytes
    dataType:MPSDataTypeFloat32];
  return [[MPSMatrix alloc] initWithBuffer:M.buffer descriptor:desc];
}

class MetalProduct {
 public:
  MetalProduct(id<MTLDevice> device, const MetalMatrix& A,
               const MetalMatrix& B, const MetalMatrix& C,
               bool transpose_left, bool transpose_right) {
    const NSUInteger rows = transpose_left ? A.cols : A.rows;
    const NSUInteger inner = transpose_left ? A.rows : A.cols;
    const NSUInteger columns = transpose_right ? B.rows : B.cols;
    if (inner != (transpose_right ? B.cols : B.rows) ||
        C.rows != rows || C.cols != columns) {
      throw std::runtime_error("Metal product workspace dimensions do not match");
    }
    left_ = mps_matrix(A);
    right_ = mps_matrix(B);
    result_ = mps_matrix(C);
    product_ = [[MPSMatrixMultiplication alloc]
      initWithDevice:device transposeLeft:transpose_left
      transposeRight:transpose_right resultRows:rows resultColumns:columns
      interiorColumns:inner alpha:1.0 beta:0.0];
  }

  void encode(id<MTLCommandBuffer> command) const {
    [product_ encodeToCommandBuffer:command leftMatrix:left_
      rightMatrix:right_ resultMatrix:result_];
  }

 private:
  MPSMatrix* left_;
  MPSMatrix* right_;
  MPSMatrix* result_;
  MPSMatrixMultiplication* product_;
};

void run_metal_products(id<MTLCommandQueue> queue,
                        std::initializer_list<const MetalProduct*> products) {
  id<MTLCommandBuffer> command = [queue commandBuffer];
  if (command == nil) {
    throw std::runtime_error("Metal workspace failed to create a command buffer");
  }
  for (const MetalProduct* product : products) product->encode(command);
  [command commit];
  [command waitUntilCompleted];
  NSError* error = [command error];
  if (error != nil) {
    throw std::runtime_error(std::string("Metal workspace command failed: ") +
      std::string([[error localizedDescription] UTF8String]));
  }
}

class MetalHostProduct {
 public:
  MetalHostProduct(id<MTLDevice> device, NSUInteger ar, NSUInteger ac,
                   NSUInteger br, NSUInteger bc, bool tl, bool tr)
      : left(make_matrix(device, ar, ac)), right(make_matrix(device, br, bc)),
        result(make_matrix(device, tl ? ac : ar, tr ? br : bc)),
        product(device, left, right, result, tl, tr),
        transpose_left(tl), transpose_right(tr) {}

  bool matches(NSUInteger ar, NSUInteger ac, NSUInteger br, NSUInteger bc,
                bool tl, bool tr) const {
    return left.rows == ar && left.cols == ac && right.rows == br &&
      right.cols == bc && transpose_left == tl && transpose_right == tr;
  }

  MetalMatrix left, right, result;
  MetalProduct product;
  bool transpose_left, transpose_right;
};

// Cache allocation and descriptors, never matrix values. The lock covers the
// synchronous product and output copy, so another caller cannot reuse live data.
class MetalHostProductCache {
 public:
  std::mutex mutex;

  MetalHostProduct& acquire(id<MTLDevice> device, NSUInteger ar, NSUInteger ac,
                            NSUInteger br, NSUInteger bc, bool tl, bool tr,
                            std::unique_ptr<MetalHostProduct>& transient) {
    for (auto item = entries_.begin(); item != entries_.end(); ++item) {
      if ((*item)->matches(ar, ac, br, bc, tl, tr)) {
        entries_.splice(entries_.begin(), entries_, item);
        return *entries_.front();
      }
    }
    const std::size_t bytes = storage(ar, ac) + storage(br, bc) +
      storage(tl ? ac : ar, tr ? br : bc);
    // Large one-off products must not retain device memory between fits.
    if (bytes > limit_) {
      entries_.clear();
      bytes_ = 0;
      transient.reset(new MetalHostProduct(device, ar, ac, br, bc, tl, tr));
      return *transient;
    }
    while (!entries_.empty() && (entries_.size() >= 8 || bytes_ + bytes > limit_)) {
      const auto& last = *entries_.back();
      bytes_ -= storage(last.left.rows, last.left.cols) +
        storage(last.right.rows, last.right.cols) +
        storage(last.result.rows, last.result.cols);
      entries_.pop_back();
    }
    auto entry = std::unique_ptr<MetalHostProduct>(
      new MetalHostProduct(device, ar, ac, br, bc, tl, tr));
    entries_.push_front(std::move(entry));
    bytes_ += bytes;
    return *entries_.front();
  }

 private:
  static std::size_t storage(NSUInteger rows, NSUInteger columns) {
    const NSUInteger stride = [MPSMatrixDescriptor rowBytesFromColumns:columns
      dataType:MPSDataTypeFloat32];
    if (stride != 0 && rows > limit_ / stride) return limit_ + 1;
    return rows * stride;
  }
  static constexpr std::size_t limit_ = 64u * 1024u * 1024u;
  std::size_t bytes_ = 0;
  std::list<std::unique_ptr<MetalHostProduct>> entries_;
};

MetalHostProductCache& host_product_cache() {
  static MetalHostProductCache cache;
  return cache;
}

MetalMatrix metal_matmul(id<MTLDevice> device,
                         id<MTLCommandQueue> queue,
                         const MetalMatrix& A,
                         const MetalMatrix& B,
                         const bool transpose_left,
                         const bool transpose_right) {
  const NSUInteger a_rows = transpose_left ? A.cols : A.rows;
  const NSUInteger a_cols = transpose_left ? A.rows : A.cols;
  const NSUInteger b_rows = transpose_right ? B.cols : B.rows;
  const NSUInteger b_cols = transpose_right ? B.rows : B.cols;
  if (a_cols != b_rows) {
    throw std::runtime_error("metal_simpls_resident: non-conformable resident matrices");
  }

  MetalMatrix C = make_matrix(device, a_rows, b_cols);
  MPSMatrix* a_matrix = mps_matrix(A);
  MPSMatrix* b_matrix = mps_matrix(B);
  MPSMatrix* c_matrix = mps_matrix(C);
  MPSMatrixMultiplication* mult = [[MPSMatrixMultiplication alloc]
    initWithDevice:device
    transposeLeft:transpose_left
    transposeRight:transpose_right
    resultRows:a_rows
    resultColumns:b_cols
    interiorColumns:a_cols
    alpha:1.0
    beta:0.0];

  id<MTLCommandBuffer> command_buffer = [queue commandBuffer];
  if (command_buffer == nil) {
    throw std::runtime_error("metal_simpls_resident: failed to create command buffer");
  }
  [mult encodeToCommandBuffer:command_buffer leftMatrix:a_matrix rightMatrix:b_matrix resultMatrix:c_matrix];
  [command_buffer commit];
  [command_buffer waitUntilCompleted];
  NSError* err = [command_buffer error];
  if (err != nil) {
    NSString* msg = [err localizedDescription];
    throw std::runtime_error(std::string("metal_simpls_resident: Metal command failed: ") +
                             std::string([msg UTF8String]));
  }
  return C;
}

arma::vec copy_metal_vector(const MetalMatrix& M) {
  const NSUInteger stride = M.row_bytes / sizeof(float);
  const float* base = static_cast<const float*>([M.buffer contents]);
  if (M.cols == 1) {
    arma::vec out(M.rows);
    for (NSUInteger i = 0; i < M.rows; ++i) out[i] = static_cast<double>(base[i * stride]);
    return out;
  }
  if (M.rows == 1) {
    arma::vec out(M.cols);
    for (NSUInteger j = 0; j < M.cols; ++j) out[j] = static_cast<double>(base[j]);
    return out;
  }
  throw std::runtime_error("metal_simpls_resident: expected a vector buffer");
}

void write_metal_col_vector(MetalMatrix& M, const arma::vec& x) {
  if (M.cols != 1 || M.rows != x.n_elem) {
    throw std::runtime_error("metal_simpls_resident: non-conformable vector write");
  }
  const NSUInteger stride = M.row_bytes / sizeof(float);
  float* base = static_cast<float*>([M.buffer contents]);
  for (NSUInteger i = 0; i < M.rows; ++i) base[i * stride] = static_cast<float>(x[i]);
}

id<MTLComputePipelineState> rank1_sub_pipeline(id<MTLDevice> device) {
  static id<MTLComputePipelineState> pipeline = nil;
  static dispatch_once_t once;
  static std::string error_message;
  dispatch_once(&once, ^{
    NSString* source =
      @"#include <metal_stdlib>\n"
       "using namespace metal;\n"
       "kernel void rank1_sub(device float* S [[buffer(0)]],\n"
       "                      device const float* v [[buffer(1)]],\n"
       "                      device const float* row [[buffer(2)]],\n"
       "                      constant uint& nrow [[buffer(3)]],\n"
       "                      constant uint& ncol [[buffer(4)]],\n"
       "                      constant uint& s_stride [[buffer(5)]],\n"
       "                      constant uint& v_stride [[buffer(6)]],\n"
       "                      uint2 gid [[thread_position_in_grid]]) {\n"
       "  if (gid.y >= nrow || gid.x >= ncol) return;\n"
       "  S[gid.y * s_stride + gid.x] -= v[gid.y * v_stride] * row[gid.x];\n"
       "}\n";
    NSError* err = nil;
    id<MTLLibrary> library = [device newLibraryWithSource:source options:nil error:&err];
    if (library == nil || err != nil) {
      NSString* msg = err == nil ? @"unknown Metal compile error" : [err localizedDescription];
      error_message = std::string([msg UTF8String]);
      return;
    }
    id<MTLFunction> function = [library newFunctionWithName:@"rank1_sub"];
    if (function == nil) {
      error_message = "rank1_sub function not found";
      return;
    }
    pipeline = [device newComputePipelineStateWithFunction:function error:&err];
    if (pipeline == nil || err != nil) {
      NSString* msg = err == nil ? @"unknown Metal pipeline error" : [err localizedDescription];
      error_message = std::string([msg UTF8String]);
    }
  });
  if (pipeline == nil) {
    throw std::runtime_error("metal_simpls_resident: failed to build rank1 kernel: " + error_message);
  }
  return pipeline;
}

void metal_rank1_sub(id<MTLDevice> device,
                     id<MTLCommandQueue> queue,
                     MetalMatrix& S,
                     const MetalMatrix& v,
                     const MetalMatrix& row) {
  id<MTLComputePipelineState> pipeline = rank1_sub_pipeline(device);
  uint32_t nrow = static_cast<uint32_t>(S.rows);
  uint32_t ncol = static_cast<uint32_t>(S.cols);
  uint32_t s_stride = static_cast<uint32_t>(S.row_bytes / sizeof(float));
  uint32_t v_stride = static_cast<uint32_t>(v.row_bytes / sizeof(float));

  id<MTLBuffer> nrow_buffer = [device newBufferWithBytes:&nrow length:sizeof(uint32_t) options:MTLResourceStorageModeShared];
  id<MTLBuffer> ncol_buffer = [device newBufferWithBytes:&ncol length:sizeof(uint32_t) options:MTLResourceStorageModeShared];
  id<MTLBuffer> s_stride_buffer = [device newBufferWithBytes:&s_stride length:sizeof(uint32_t) options:MTLResourceStorageModeShared];
  id<MTLBuffer> v_stride_buffer = [device newBufferWithBytes:&v_stride length:sizeof(uint32_t) options:MTLResourceStorageModeShared];

  id<MTLCommandBuffer> command_buffer = [queue commandBuffer];
  id<MTLComputeCommandEncoder> encoder = [command_buffer computeCommandEncoder];
  [encoder setComputePipelineState:pipeline];
  [encoder setBuffer:S.buffer offset:0 atIndex:0];
  [encoder setBuffer:v.buffer offset:0 atIndex:1];
  [encoder setBuffer:row.buffer offset:0 atIndex:2];
  [encoder setBuffer:nrow_buffer offset:0 atIndex:3];
  [encoder setBuffer:ncol_buffer offset:0 atIndex:4];
  [encoder setBuffer:s_stride_buffer offset:0 atIndex:5];
  [encoder setBuffer:v_stride_buffer offset:0 atIndex:6];

  MTLSize grid = MTLSizeMake(S.cols, S.rows, 1);
  NSUInteger w = std::min<NSUInteger>(16, pipeline.threadExecutionWidth);
  MTLSize threads = MTLSizeMake(w, 16, 1);
  [encoder dispatchThreads:grid threadsPerThreadgroup:threads];
  [encoder endEncoding];
  [command_buffer commit];
  [command_buffer waitUntilCompleted];
  NSError* err = [command_buffer error];
  if (err != nil) {
    NSString* msg = [err localizedDescription];
    throw std::runtime_error(std::string("metal_simpls_resident: rank1 kernel failed: ") +
                             std::string([msg UTF8String]));
  }
}

void project_left_inplace(arma::vec& x,
                          const arma::mat& V,
                          const int n_prev) {
  if (n_prev <= 0) return;
  const int use_prev = std::min<int>(n_prev, static_cast<int>(V.n_cols));
  if (use_prev <= 0) return;
  const arma::mat Vprev = V.cols(0, use_prev - 1);
  x -= Vprev * (Vprev.t() * x);
}

} // namespace

struct MetalFloatOperator::Impl {
  struct Product {
    Product(id<MTLDevice> device, const MetalMatrix& left,
            NSUInteger columns, bool transpose)
        : right(make_matrix(device, transpose ? left.rows : left.cols, columns)),
          result(make_matrix(device, transpose ? left.cols : left.rows, columns)),
          operation(device, left, right, result, transpose, false),
          transpose_left(transpose) {}
    MetalMatrix right, result;
    MetalProduct operation;
    bool transpose_left;
  };

  struct Geometry {
    Geometry(id<MTLDevice> device, const MetalMatrix& left,
             NSUInteger columns)
        : directions(make_matrix(device, left.cols, columns)),
          scores(make_matrix(device, left.rows, columns)),
          loadings(make_matrix(device, left.cols, columns)),
          score_product(device, left, directions, scores, false, false),
          loading_product(device, left, scores, loadings, true, false) {}
    MetalMatrix directions, scores, loadings;
    MetalProduct score_product, loading_product;
  };

  explicit Impl(const arma::fmat& A) {
    device = default_device();
    queue = default_command_queue();
    if (device == nil || queue == nil) {
      throw std::runtime_error(
        "Metal float32 operator is unavailable; no CPU fallback is performed");
    }
    if (A.n_rows == 0 || A.n_cols == 0) {
      throw std::runtime_error("Metal float32 operator requires a nonempty matrix");
    }
    left = make_matrix(device, A.n_rows, A.n_cols);
    copy_fmat_to_mps_buffer(A, left.buffer, left.row_bytes);
  }

  Product& product(NSUInteger columns, bool transpose) {
    for (auto item = products.begin(); item != products.end(); ++item) {
      if ((*item)->right.cols == columns && (*item)->transpose_left == transpose) {
        products.splice(products.begin(), products, item);
        return *products.front();
      }
    }
    // A range solve alternates forward/reverse products of one sketch width.
    // Keep that pair, not every width ever requested by the caller.
    if (products.size() == 2) products.pop_back();
    products.emplace_front(new Product(device, left, columns, transpose));
    return *products.front();
  }

  Geometry& geometry(NSUInteger columns) {
    for (auto item = geometries.begin(); item != geometries.end(); ++item) {
      if ((*item)->directions.cols == columns) {
        geometries.splice(geometries.begin(), geometries, item);
        return *geometries.front();
      }
    }
    if (geometries.size() == 2) geometries.pop_back();
    geometries.emplace_front(new Geometry(device, left, columns));
    return *geometries.front();
  }

  id<MTLDevice> device;
  id<MTLCommandQueue> queue;
  MetalMatrix left;
  std::list<std::unique_ptr<Product>> products;
  std::list<std::unique_ptr<Geometry>> geometries;
  std::mutex mutex;
};

MetalFloatOperator::MetalFloatOperator(const arma::fmat& A) {
  @autoreleasepool {
    impl_.reset(new Impl(A));
  }
}

MetalFloatOperator::~MetalFloatOperator() = default;

void MetalFloatOperator::update(const arma::fmat& A) {
  std::lock_guard<std::mutex> lock(impl_->mutex);
  if (A.n_rows != impl_->left.rows || A.n_cols != impl_->left.cols) {
    throw std::runtime_error("Metal float32 operator update changed matrix dimensions");
  }
  copy_fmat_to_mps_buffer(A, impl_->left.buffer, impl_->left.row_bytes);
}

arma::fmat MetalFloatOperator::multiply(const arma::fmat& B, bool transpose_left) {
  std::lock_guard<std::mutex> lock(impl_->mutex);
  const NSUInteger inner = transpose_left ? impl_->left.rows : impl_->left.cols;
  const NSUInteger rows = transpose_left ? impl_->left.cols : impl_->left.rows;
  if (B.n_rows != inner) {
    throw std::runtime_error("Metal float32 operator: non-conformable matrices");
  }
  if (B.n_cols == 0) return arma::fmat(rows, 0);
  @autoreleasepool {
    Impl::Product& workspace = impl_->product(B.n_cols, transpose_left);
    copy_fmat_to_mps_buffer(B, workspace.right.buffer, workspace.right.row_bytes);
    run_metal_products(impl_->queue, {&workspace.operation});
    return copy_mps_buffer_to_fmat(workspace.result.buffer, rows, B.n_cols,
                                  workspace.result.row_bytes);
  }
}

void MetalFloatOperator::geometry(const arma::fmat& directions,
                                  arma::fmat& scores,
                                  arma::fmat& loadings) {
  std::lock_guard<std::mutex> lock(impl_->mutex);
  if (directions.n_rows != impl_->left.cols) {
    throw std::runtime_error(
      "Metal float32 geometry: non-conformable direction matrix"
    );
  }
  if (directions.n_cols == 0) {
    scores.set_size(impl_->left.rows, 0);
    loadings.set_size(impl_->left.cols, 0);
    return;
  }
  @autoreleasepool {
    Impl::Geometry& workspace = impl_->geometry(directions.n_cols);
    copy_fmat_to_mps_buffer(
      directions, workspace.directions.buffer, workspace.directions.row_bytes
    );
    run_metal_products(
      impl_->queue,
      {&workspace.score_product, &workspace.loading_product}
    );
    scores = copy_mps_buffer_to_fmat(
      workspace.scores.buffer, impl_->left.rows, directions.n_cols,
      workspace.scores.row_bytes
    );
    loadings = copy_mps_buffer_to_fmat(
      workspace.loadings.buffer, impl_->left.cols, directions.n_cols,
      workspace.loadings.row_bytes
    );
  }
}

struct MetalFloatCrossproduct::Impl {
  struct Deflation {
    Deflation(id<MTLDevice> device, const MetalMatrix& X)
        : weight(make_matrix(device, X.cols, 1)),
          row(make_matrix(device, 1, X.cols)),
          score(make_matrix(device, X.rows, 1)),
          product(device, X, weight, score, false, false) {}
    MetalMatrix weight, row, score;
    MetalProduct product;
  };
  struct Product {
    Product(id<MTLDevice> device, const MetalMatrix& X, const MetalMatrix& Y,
            NSUInteger width, bool transposed)
        : input(make_matrix(device, transposed ? X.cols : Y.cols, width)),
          intermediate(make_matrix(device, X.rows, width)),
          result(make_matrix(device, transposed ? Y.cols : X.cols, width)),
          first(device, transposed ? X : Y, input, intermediate, false, false),
          second(device, transposed ? Y : X, intermediate, result, true, false),
          transpose(transposed) {}
    MetalMatrix input, intermediate, result;
    MetalProduct first, second;
    bool transpose;
  };

  template<typename T>
  Impl(const arma::Mat<T>& x, const arma::Mat<T>& y) {
    device = default_device();
    queue = default_command_queue();
    if (device == nil || queue == nil) {
      throw std::runtime_error("Metal cross-product unavailable; no CPU fallback is performed");
    }
    if (x.n_rows != y.n_rows || x.n_elem == 0 || y.n_elem == 0) {
      throw std::runtime_error("Metal cross-product requires nonempty X and Y with matching rows");
    }
    X = make_matrix(device, x.n_rows, x.n_cols);
    Y = make_matrix(device, y.n_rows, y.n_cols);
    if constexpr (std::is_same<T, float>::value) {
      copy_fmat_to_mps_buffer(x, X.buffer, X.row_bytes);
      copy_fmat_to_mps_buffer(y, Y.buffer, Y.row_bytes);
    } else {
      copy_arma_to_mps_buffer(x, X.buffer, X.row_bytes);
      copy_arma_to_mps_buffer(y, Y.buffer, Y.row_bytes);
    }
  }

  Product& product(NSUInteger width, bool transpose) {
    for (auto item = products.begin(); item != products.end(); ++item) {
      if ((*item)->input.cols == width && (*item)->transpose == transpose) {
        products.splice(products.begin(), products, item);
        return *products.front();
      }
    }
    if (products.size() == 2) products.pop_back();
    products.emplace_front(new Product(device, X, Y, width, transpose));
    return *products.front();
  }
  id<MTLDevice> device;
  id<MTLCommandQueue> queue;
  MetalMatrix X, Y;
  std::list<std::unique_ptr<Product>> products;
  std::unique_ptr<Deflation> deflation;
  std::mutex mutex;
};

MetalFloatCrossproduct::MetalFloatCrossproduct(const arma::fmat& X, const arma::fmat& Y) {
  @autoreleasepool { impl_.reset(new Impl(X, Y)); }
}
MetalFloatCrossproduct::MetalFloatCrossproduct(const arma::mat& X, const arma::mat& Y) {
  @autoreleasepool { impl_.reset(new Impl(X, Y)); }
}
MetalFloatCrossproduct::~MetalFloatCrossproduct() = default;
arma::fmat MetalFloatCrossproduct::multiply(const arma::fmat& B, bool transpose) {
  std::lock_guard<std::mutex> lock(impl_->mutex);
  const NSUInteger inner = transpose ? impl_->X.cols : impl_->Y.cols;
  const NSUInteger rows = transpose ? impl_->Y.cols : impl_->X.cols;
  if (B.n_rows != inner) {
    throw std::runtime_error("Metal float32 cross-product: non-conformable matrices");
  }
  if (B.n_cols == 0) return arma::fmat(rows, 0);
  @autoreleasepool {
    auto& workspace = impl_->product(B.n_cols, transpose);
    copy_fmat_to_mps_buffer(B, workspace.input.buffer, workspace.input.row_bytes);
    run_metal_products(impl_->queue, {&workspace.first, &workspace.second});
    return copy_mps_buffer_to_fmat(workspace.result.buffer, rows, B.n_cols,
                                  workspace.result.row_bytes);
  }
}

arma::mat MetalFloatCrossproduct::multiply(const arma::mat& B, bool transpose) {
  std::lock_guard<std::mutex> lock(impl_->mutex);
  const NSUInteger inner = transpose ? impl_->X.cols : impl_->Y.cols;
  const NSUInteger rows = transpose ? impl_->Y.cols : impl_->X.cols;
  if (B.n_rows != inner) {
    throw std::runtime_error("Metal cross-product: non-conformable matrices");
  }
  if (B.n_cols == 0) return arma::mat(rows, 0);
  @autoreleasepool {
    auto& workspace = impl_->product(B.n_cols, transpose);
    copy_arma_to_mps_buffer(B, workspace.input.buffer, workspace.input.row_bytes);
    run_metal_products(impl_->queue, {&workspace.first, &workspace.second});
    return copy_mps_buffer_to_arma(workspace.result.buffer, rows, B.n_cols,
                                  workspace.result.row_bytes);
  }
}

void MetalFloatCrossproduct::deflate(const arma::fvec& v) {
  std::lock_guard<std::mutex> lock(impl_->mutex);
  if (v.n_elem != impl_->X.cols) {
    throw std::runtime_error("Metal float32 factor deflation: invalid direction size");
  }
  @autoreleasepool {
    if (!impl_->deflation) {
      impl_->deflation.reset(new Impl::Deflation(impl_->device, impl_->X));
    }
    auto& workspace = *impl_->deflation;
    copy_fmat_to_mps_buffer(v, workspace.weight.buffer, workspace.weight.row_bytes);
    copy_fmat_to_mps_buffer(arma::fmat(v.t()), workspace.row.buffer, workspace.row.row_bytes);
    run_metal_products(impl_->queue, {&workspace.product});
    metal_rank1_sub(impl_->device, impl_->queue, impl_->X, workspace.score, workspace.row);
  }
}

arma::fmat MetalFloatCrossproduct::left_factor() {
  std::lock_guard<std::mutex> lock(impl_->mutex);
  return copy_mps_buffer_to_fmat(impl_->X.buffer, impl_->X.rows, impl_->X.cols,
                                impl_->X.row_bytes);
}

bool has_metal_backend() {
  @autoreleasepool {
    id<MTLDevice> device = default_device();
    return device != nil;
  }
}

arma::mat metal_matrix_multiply(const arma::mat& A,
                                const arma::mat& B,
                                const bool transpose_left,
                                const bool transpose_right) {
  const arma::uword a_rows = transpose_left ? A.n_cols : A.n_rows;
  const arma::uword a_cols = transpose_left ? A.n_rows : A.n_cols;
  const arma::uword b_rows = transpose_right ? B.n_cols : B.n_rows;
  const arma::uword b_cols = transpose_right ? B.n_rows : B.n_cols;

  if (a_cols != b_rows) {
    throw std::runtime_error("metal_matrix_multiply: non-conformable matrices");
  }

  @autoreleasepool {
    id<MTLDevice> device = default_device();
    if (device == nil) {
      throw std::runtime_error(
        "metal_matrix_multiply: no Metal device available; no CPU fallback is performed"
      );
    }

    id<MTLCommandQueue> queue = default_command_queue();
    if (queue == nil) {
      throw std::runtime_error("metal_matrix_multiply: failed to create Metal command queue");
    }

    if (a_rows == 0 || b_cols == 0 || a_cols == 0) {
      return arma::mat(a_rows, b_cols, arma::fill::zeros);
    }
    auto& cache = host_product_cache();
    std::lock_guard<std::mutex> lock(cache.mutex);
    std::unique_ptr<MetalHostProduct> transient;
    auto& workspace = cache.acquire(device, A.n_rows, A.n_cols, B.n_rows,
      B.n_cols, transpose_left, transpose_right, transient);
    copy_arma_to_mps_buffer(A, workspace.left.buffer, workspace.left.row_bytes);
    copy_arma_to_mps_buffer(B, workspace.right.buffer, workspace.right.row_bytes);
    run_metal_products(queue, {&workspace.product});
    return copy_mps_buffer_to_arma(workspace.result.buffer, a_rows, b_cols,
      workspace.result.row_bytes);
  }
}

arma::fmat metal_matrix_multiply_float(const arma::fmat& A,
                                       const arma::fmat& B,
                                       const bool transpose_left,
                                       const bool transpose_right) {
  const arma::uword a_rows = transpose_left ? A.n_cols : A.n_rows;
  const arma::uword a_cols = transpose_left ? A.n_rows : A.n_cols;
  const arma::uword b_rows = transpose_right ? B.n_cols : B.n_rows;
  const arma::uword b_cols = transpose_right ? B.n_rows : B.n_cols;

  if (a_cols != b_rows) {
    throw std::runtime_error("metal_matrix_multiply_float: non-conformable matrices");
  }

  @autoreleasepool {
    id<MTLDevice> device = default_device();
    if (device == nil) {
      throw std::runtime_error(
        "metal_matrix_multiply_float: no Metal device available; no CPU fallback is performed"
      );
    }

    id<MTLCommandQueue> queue = default_command_queue();
    if (queue == nil) {
      throw std::runtime_error("metal_matrix_multiply_float: failed to create Metal command queue");
    }

    if (a_rows == 0 || b_cols == 0 || a_cols == 0) {
      return arma::fmat(a_rows, b_cols, arma::fill::zeros);
    }
    auto& cache = host_product_cache();
    std::lock_guard<std::mutex> lock(cache.mutex);
    std::unique_ptr<MetalHostProduct> transient;
    auto& workspace = cache.acquire(device, A.n_rows, A.n_cols, B.n_rows,
      B.n_cols, transpose_left, transpose_right, transient);
    copy_fmat_to_mps_buffer(A, workspace.left.buffer, workspace.left.row_bytes);
    copy_fmat_to_mps_buffer(B, workspace.right.buffer, workspace.right.row_bytes);
    run_metal_products(queue, {&workspace.product});
    return copy_mps_buffer_to_fmat(workspace.result.buffer, a_rows, b_cols,
      workspace.result.row_bytes);
  }
}

arma::mat metal_matrix_multiply(const arma::mat& A, const arma::mat& B) {
  return metal_matrix_multiply(A, B, false, false);
}

arma::mat metal_crossprod(const arma::mat& A, const arma::mat& B) {
  return metal_matrix_multiply(A, B, true, false);
}

Rcpp::List metal_simpls_resident(const arma::mat& X,
                                 const arma::mat& Y,
                                 int ncomp,
                                 int power_iters,
                                 int seed) {
  if (X.n_rows != Y.n_rows) {
    throw std::runtime_error("metal_simpls_resident: X and Y must have the same number of rows");
  }
  const int max_comp = std::max(1, std::min<int>(ncomp, std::min<int>(X.n_cols, X.n_rows - 1)));
  const int q = static_cast<int>(Y.n_cols);
  if (q < 1) {
    throw std::runtime_error("metal_simpls_resident: Y must have at least one column");
  }
  const int iters = std::max(1, power_iters);
  (void) iters;

  @autoreleasepool {
    id<MTLDevice> device = default_device();
    if (device == nil) {
      throw std::runtime_error(
        "metal_simpls_resident: no Metal device available; no CPU fallback is performed"
      );
    }
    id<MTLCommandQueue> queue = default_command_queue();
    if (queue == nil) {
      throw std::runtime_error("metal_simpls_resident: failed to create Metal command queue");
    }

    MetalMatrix Xg = make_matrix_from_arma(device, X);
    MetalMatrix Yg = make_matrix_from_arma(device, Y);

    const double s_mb = static_cast<double>(X.n_cols) *
      static_cast<double>(Y.n_cols) * sizeof(float) / 1024.0 / 1024.0;
    const bool use_xprod = s_mb > 32.0;
    MetalMatrix Sg;
    if (!use_xprod) {
      Sg = metal_matmul(device, queue, Xg, Yg, true, false);
    }

    arma::mat RR(X.n_cols, max_comp, arma::fill::zeros);
    arma::mat QQ(Y.n_cols, max_comp, arma::fill::zeros);
    arma::mat VV(X.n_cols, max_comp, arma::fill::zeros);
    int used_comp = 0;

    std::mt19937 rng(static_cast<unsigned int>(seed));
    std::normal_distribution<float> normal(0.0f, 1.0f);

    MetalMatrix rbuf = make_matrix(device, static_cast<NSUInteger>(X.n_cols), 1);
    MetalMatrix ttbuf = make_matrix(device, static_cast<NSUInteger>(X.n_rows), 1);
    MetalMatrix vvbuf = make_matrix(device, static_cast<NSUInteger>(X.n_cols), 1);
    MetalMatrix zbuf = make_matrix(device, static_cast<NSUInteger>(q), 1);
    MetalMatrix xybuf = make_matrix(device, static_cast<NSUInteger>(X.n_rows), 1);
    MetalMatrix ppbuf = make_matrix(device, static_cast<NSUInteger>(X.n_cols), 1);
    MetalMatrix qqbuf = make_matrix(device, static_cast<NSUInteger>(q), 1);
    MetalMatrix rowbuf = make_matrix(device, 1, static_cast<NSUInteger>(q));
    MetalProduct score_product(device, Xg, rbuf, ttbuf, false, false);
    MetalProduct predictor_loading(device, Xg, ttbuf, ppbuf, true, false);
    MetalProduct response_loading(device, Yg, ttbuf, qqbuf, true, false);
    MetalProduct x_direction(device, Xg, rbuf, xybuf, false, false);
    MetalProduct yt_direction(device, Yg, xybuf, zbuf, true, false);
    MetalProduct y_direction(device, Yg, zbuf, xybuf, false, false);
    MetalProduct xt_direction(device, Xg, xybuf, rbuf, true, false);
    std::unique_ptr<MetalProduct> st_direction, s_direction, deflation_row;
    if (!use_xprod) {
      st_direction.reset(new MetalProduct(device, Sg, rbuf, zbuf, true, false));
      s_direction.reset(new MetalProduct(device, Sg, zbuf, rbuf, false, false));
      deflation_row.reset(new MetalProduct(device, vvbuf, Sg, rowbuf, true, false));
    }
    for (int a = 0; a < max_comp; ++a) {
      arma::vec rr(X.n_cols);
      // A fresh direction avoids propagating approximation error across
      // deflated components on the Metal route.
      for (arma::uword j = 0; j < X.n_cols; ++j) {
        rr[j] = static_cast<double>(normal(rng));
      }
      double rnorm = arma::norm(rr, 2);
      if (!std::isfinite(rnorm) || rnorm <= std::numeric_limits<double>::epsilon()) break;
      rr /= rnorm;
      project_left_inplace(rr, VV, a);
      rnorm = arma::norm(rr, 2);
      if (!std::isfinite(rnorm) || rnorm <= std::numeric_limits<double>::epsilon()) break;
      rr /= rnorm;
      write_metal_col_vector(rbuf, rr);
      for (int it = 0; it < iters; ++it) {
        if (use_xprod) {
          run_metal_products(queue, {
            &x_direction, &yt_direction, &y_direction, &xt_direction
          });
        } else {
          run_metal_products(queue, {st_direction.get(), s_direction.get()});
        }
        rr = copy_metal_vector(rbuf);
        project_left_inplace(rr, VV, a);
        rnorm = arma::norm(rr, 2);
        if (!std::isfinite(rnorm) || rnorm <= std::numeric_limits<double>::epsilon()) break;
        rr /= rnorm;
        write_metal_col_vector(rbuf, rr);
      }
      rr = copy_metal_vector(rbuf);
      project_left_inplace(rr, VV, a);
      rnorm = arma::norm(rr, 2);
      if (!std::isfinite(rnorm) || rnorm <= std::numeric_limits<double>::epsilon()) break;
      rr /= rnorm;

      write_metal_col_vector(rbuf, rr);

      run_metal_products(queue, {&score_product});
      arma::vec tt = copy_metal_vector(ttbuf);
      double tnorm = arma::norm(tt, 2);
      if (!std::isfinite(tnorm) || tnorm <= std::numeric_limits<double>::epsilon()) break;
      tt /= tnorm;
      rr /= tnorm;
      write_metal_col_vector(ttbuf, tt);

      run_metal_products(queue, {&predictor_loading, &response_loading});
      arma::vec pp = copy_metal_vector(ppbuf);
      arma::vec qq = copy_metal_vector(qqbuf);

      arma::vec vv = pp;
      if (a > 0) {
        arma::mat Vprev = VV.cols(0, a - 1);
        vv -= Vprev * (Vprev.t() * pp);
      }
      double vvnorm = arma::norm(vv, 2);
      if (!std::isfinite(vvnorm) || vvnorm <= std::numeric_limits<double>::epsilon()) break;
      vv /= vvnorm;
      write_metal_col_vector(vvbuf, vv);

      if (!use_xprod) {
        run_metal_products(queue, {deflation_row.get()});
        metal_rank1_sub(device, queue, Sg, vvbuf, rowbuf);
      }

      RR.col(a) = rr;
      QQ.col(a) = qq;
      VV.col(a) = vv;
      used_comp = a + 1;
    }

    arma::mat RRout = used_comp > 0 ? RR.cols(0, used_comp - 1) : arma::mat(X.n_cols, 0);
    arma::mat QQout = used_comp > 0 ? QQ.cols(0, used_comp - 1) : arma::mat(Y.n_cols, 0);
    arma::mat VVout = used_comp > 0 ? VV.cols(0, used_comp - 1) : arma::mat(X.n_cols, 0);

    return Rcpp::List::create(
      Rcpp::Named("R") = RRout,
      Rcpp::Named("Q") = QQout,
      Rcpp::Named("V") = VVout,
      Rcpp::Named("ncomp") = used_comp
    );
  }
}

} // namespace fastpls_svd
