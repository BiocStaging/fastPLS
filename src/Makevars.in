CXX_STD = CXX17

PKG_CXXFLAGS = -I../inst/include/ @FASTPLS_PKG_CXXFLAGS@
PKG_CPPFLAGS = -DFASTPLS_CORE_ONLY @FASTPLS_PKG_CPPFLAGS@
PKG_LIBS = @FASTPLS_PKG_LIBS@ $(FLIBS)

OBJECTS = core_init.o core_accelerator_stubs.o core_cpu_backend.o \
	core_cpu_lapack.o core_cpu_lapack_f32.o r_api.o rsvd_audit.o \
	cuda_resident_r.o@FASTPLS_METAL_OBJECTS@@FASTPLS_CUDA_OBJECTS@
