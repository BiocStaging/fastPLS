@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(BLAS)
find_dependency(LAPACK)
find_path(ARMADILLO_INCLUDE_DIR armadillo REQUIRED)
include("${CMAKE_CURRENT_LIST_DIR}/fastplsNativeTargets.cmake")
# Rediscover external headers rather than recording the producer's location.
set_property(TARGET fastpls::native APPEND PROPERTY INTERFACE_INCLUDE_DIRECTORIES
  "${ARMADILLO_INCLUDE_DIR}")
check_required_components(fastpls_native)
