#!/usr/bin/env sh
set -eu

use_cuda="${FASTPLS_USE_CUDA:-auto}"
require_cuda="${FASTPLS_REQUIRE_CUDA:-0}"
cuda_root="${CUDA_ROOT:-${CUDA_PATH:-}}"
use_openblas="${FASTPLS_USE_OPENBLAS:-auto}"
openblas_root="${OPENBLAS_ROOT:-}"

normalize_path() {
  p="$1"
  p=$(printf "%s" "$p" | sed 's|\\|/|g')
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -m "$p" 2>/dev/null || printf "%s" "$p"
  else
    printf "%s" "$p"
  fi
}

find_cuda_root() {
  if [ -n "${cuda_root}" ]; then
    normalize_path "${cuda_root}"
    return
  fi

  for d in \
    "/c/Program Files/NVIDIA GPU Computing Toolkit/CUDA"/v* \
    "/C/Program Files/NVIDIA GPU Computing Toolkit/CUDA"/v* \
    "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA"/v*
  do
    if [ -d "$d" ]; then
      normalize_path "$d"
      return
    fi
  done
}

cuda_root="$(find_cuda_root || true)"
have_cuda=0

if [ "${use_cuda}" != "0" ] && [ "${use_cuda}" != "false" ] && [ "${use_cuda}" != "FALSE" ]; then
  if [ -n "${cuda_root}" ] &&
     [ -f "${cuda_root}/include/cuda_runtime.h" ] &&
     [ -d "${cuda_root}/lib/x64" ] &&
     [ -f "${cuda_root}/bin/nvcc.exe" ]; then
    have_cuda=1
  fi
fi

if [ "${require_cuda}" = "1" ] && [ "${have_cuda}" != "1" ]; then
  echo "ERROR: FASTPLS_REQUIRE_CUDA=1 but the CUDA Toolkit was not found." >&2
  echo "Set CUDA_ROOT to the CUDA Toolkit directory, for example:" >&2
  echo "  C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.6" >&2
  exit 1
fi

if [ "${use_cuda}" = "1" ] && [ "${have_cuda}" != "1" ]; then
  echo "fastPLS configure.win: FASTPLS_USE_CUDA=1 was set but the CUDA Toolkit was not found; building CPU-only Windows package"
  echo "fastPLS configure.win: set FASTPLS_REQUIRE_CUDA=1 to make missing CUDA a configuration error"
fi

openblas_cppflags=""
openblas_libs=""
openblas_origin=""

find_openblas_from_root() {
  [ -n "${openblas_root}" ] || return 1
  header="$(find "${openblas_root}/include" -name openblas_config.h -print 2>/dev/null | head -n 1 || true)"
  library="$(find "${openblas_root}" -name 'libopenblas.a' -print 2>/dev/null | head -n 1 || true)"
  [ -n "${header}" ] && [ -n "${library}" ] || return 1
  include_dir="$(normalize_path "$(dirname "${header}")")"
  library_file="$(normalize_path "${library}")"
  openblas_cppflags="-I\"${include_dir}\""
  openblas_libs="\"${library_file}\""
  openblas_origin="${openblas_root}"
}

find_rtools_openblas() {
  for candidate in \
    "${R_TOOLS_SOFT:-}" \
    "${RTOOLS46_HOME:-}" \
    "${RTOOLS45_HOME:-}" \
    "${RTOOLS44_HOME:-}" \
    /c/rtools*/x86_64-w64-mingw32.static.posix \
    /c/rtools*/aarch64-w64-mingw32.static.posix
  do
    [ -n "${candidate}" ] && [ -d "${candidate}" ] || continue
    openblas_root="${candidate}"
    if find_openblas_from_root; then
      openblas_origin="Rtools (${candidate})"
      return 0
    fi
  done
  return 1
}

find_openblas() {
  if find_openblas_from_root; then
    return 0
  fi
  if find_rtools_openblas; then
    return 0
  fi
  if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists openblas; then
    openblas_cppflags="$(pkg-config --cflags openblas)"
    openblas_libs="$(pkg-config --libs openblas)"
    openblas_origin="pkg-config"
    return 0
  fi
  return 1
}

if [ "${use_openblas}" = "true" ] || [ "${use_openblas}" = "TRUE" ]; then
  use_openblas="1"
elif [ "${use_openblas}" = "false" ] || [ "${use_openblas}" = "FALSE" ]; then
  use_openblas="0"
fi
if [ "${use_openblas}" = "auto" ]; then
  if find_openblas; then
    use_openblas="1"
  else
    use_openblas="0"
  fi
elif [ "${use_openblas}" = "1" ] && ! find_openblas; then
  echo "ERROR: FASTPLS_USE_OPENBLAS=1 but OpenBLAS was not found." >&2
  echo "Install the static OpenBLAS development archive for Rtools or set OPENBLAS_ROOT." >&2
  exit 1
elif [ "${use_openblas}" != "0" ]; then
  echo "ERROR: FASTPLS_USE_OPENBLAS must be auto, 0, or 1." >&2
  exit 1
fi

if [ "${use_openblas}" = "1" ]; then
  echo "fastPLS configure.win: using OpenBLAS (${openblas_origin})"
  pkg_cppflags="-DFASTPLS_USE_OPENBLAS ${openblas_cppflags}"
  # Rtools distributes a static OpenMP-enabled OpenBLAS archive.  The OpenMP
  # runtime must follow the archive on the link line to resolve its symbols.
  # Adding the flag is harmless for private pthread OpenBLAS builds.
  pkg_cxxflags="-fopenmp"
  pkg_libs="${openblas_libs} -fopenmp"
else
  echo "fastPLS configure.win: OpenBLAS not found; using the BLAS/LAPACK supplied by R"
  pkg_cppflags=""
  pkg_cxxflags=""
  pkg_libs='$(LAPACK_LIBS) $(BLAS_LIBS)'
fi
cuda_objects=""
cuda_rule=""

# A macOS configure run may generate the Objective-C++ Metal source.  Windows
# builds must always use the C++ stub and must never try to compile/link Metal.
rm -f src/core_metal_backend.mm src/svd_metal_backend.mm

if [ "${have_cuda}" = "1" ]; then
  echo "fastPLS configure.win: CUDA Toolkit found at ${cuda_root}"
  pkg_cppflags="${pkg_cppflags} -DFASTPLS_HAS_CUDA -DFASTPLS_HAS_CUDA_KERNELS -I\"${cuda_root}/include\""
  pkg_cxxflags="-DFASTPLS_HAS_CUDA -DFASTPLS_HAS_CUDA_KERNELS"
  pkg_libs="-L\"${cuda_root}/lib/x64\" -lcudart -lcublas -lcusolver -lcurand ${pkg_libs}"

  nvcc="${cuda_root}/bin/nvcc.exe"
  cuda_objects=" core_cuda_backend.o"
  cuda_rule='CUDA_NVCC = "'"${nvcc}"'"
CUDA_NVCCFLAGS = -std=c++17 -I../inst/include/ -I"'"${cuda_root}"'/include"

%.o: %.cu
	$(CUDA_NVCC) $(CUDA_NVCCFLAGS) -c $< -o $@'
else
  echo "fastPLS configure.win: CUDA Toolkit not found; building CPU-only Windows package"
fi

escape_sed() {
  printf "%s" "$1" | sed 's/[&]/\\&/g'
}

sed \
  -e "s|@FASTPLS_WIN_PKG_CPPFLAGS@|$(escape_sed "${pkg_cppflags}")|g" \
  -e "s|@FASTPLS_WIN_PKG_CXXFLAGS@|$(escape_sed "${pkg_cxxflags}")|g" \
  -e "s|@FASTPLS_WIN_PKG_LIBS@|$(escape_sed "${pkg_libs}")|g" \
  -e "s|@FASTPLS_WIN_CUDA_OBJECTS@|$(escape_sed "${cuda_objects}")|g" \
  -e "s|@FASTPLS_WIN_CUDA_RULE@||g" \
  src/Makevars.win.in > src/Makevars.win

if [ -n "${cuda_rule}" ]; then
  printf "\n%s\n" "${cuda_rule}" >> src/Makevars.win
fi
